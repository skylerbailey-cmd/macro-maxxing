rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // =====================================================================
    // PROFILE PHOTOS — owner writes, any authenticated user reads
    // =====================================================================
    match /profile_photos/{userID}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userID
                   && request.resource.size < 1 * 1024 * 1024
                   && request.resource.contentType.matches('image/jpeg');
    }

    // =====================================================================
    // POST PHOTOS — owner writes, any authenticated user reads
    // =====================================================================
    match /posts/{userID}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userID
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/jpeg');
      allow delete: if request.auth != null
                    && request.auth.uid == userID;
    }

    // =====================================================================
    // FOOD PHOTOS — owner only (private nutrition data)
    // =====================================================================
    match /food_photos/{userID}/{allPaths=**} {
      allow read: if request.auth != null
                  && request.auth.uid == userID;
      allow write: if request.auth != null
                   && request.auth.uid == userID
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/jpeg');
      allow delete: if request.auth != null
                    && request.auth.uid == userID;
    }

    // =====================================================================
    // FUEL LOG PHOTOS — owner only (private nutrition data)
    // =====================================================================
    match /fuel_log/{userID}/{allPaths=**} {
      allow read: if request.auth != null
                  && request.auth.uid == userID;
      allow write: if request.auth != null
                   && request.auth.uid == userID
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/jpeg');
      allow delete: if request.auth != null
                    && request.auth.uid == userID;
    }

    // =====================================================================
    // DENY EVERYTHING ELSE
    // =====================================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
