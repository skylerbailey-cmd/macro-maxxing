rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // USERS — only the owner can read/write their own document
    // =====================================================================
    match /users/{userID} {
      allow read:   if request.auth != null && request.auth.uid == userID;
      allow write:  if request.auth != null && request.auth.uid == userID;

      // Other authenticated users can read limited profile fields
      // (needed for leaderboard, feed avatars, follow lookups)
      allow read: if request.auth != null;

      // --- User subcollections: scoped to the owning user ---

      match /foodEntries/{entryID} {
        allow read, write: if request.auth != null && request.auth.uid == userID;
      }

      match /fuelLog/{dateID} {
        allow read, write: if request.auth != null && request.auth.uid == userID;
      }

      match /macroHistory/{dateID} {
        allow read, write: if request.auth != null && request.auth.uid == userID;
      }

      match /workoutEntries/{entryID} {
        allow read, write: if request.auth != null && request.auth.uid == userID;
      }

      match /balanceScoreHistory/{dateID} {
        allow read, write: if request.auth != null && request.auth.uid == userID;
      }

      match /scanStats/{docID} {
        allow read, write: if request.auth != null && request.auth.uid == userID;
      }

      // Following/followers: owner can read/write, others can read
      // (needed for follow state checks and follower counts)
      match /following/{targetID} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userID;
      }

      match /followers/{followerID} {
        allow read:  if request.auth != null;
        // Write allowed by the follower (adding themselves) or the owner (removing)
        allow write: if request.auth != null
                     && (request.auth.uid == userID || request.auth.uid == followerID);
      }

      // Notifications: only the owner reads; other users can create (send notifications)
      match /notifications/{notifID} {
        allow read:   if request.auth != null && request.auth.uid == userID;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == userID;
      }

      // Subscribers: owner can read/write, other users can add/remove themselves
      match /subscribers/{subscriberID} {
        allow read:  if request.auth != null && request.auth.uid == userID;
        allow write: if request.auth != null
                     && (request.auth.uid == userID || request.auth.uid == subscriberID);
      }
    }

    // =====================================================================
    // POSTS — readable by all authenticated users, writable only by author
    // =====================================================================
    match /posts/{postID} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userID == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.userID == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userID == request.auth.uid;

      // Comments: readable by all authenticated users, writable by the comment author
      match /comments/{commentID} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null
                              && resource.data.authorID == request.auth.uid;
      }
    }

    // =====================================================================
    // WEEKLY SNAPSHOTS — read-only for authenticated users
    // Written only by Cloud Functions (admin SDK bypasses rules)
    // =====================================================================
    match /weeklySnapshots/{snapshotID} {
      allow read:  if request.auth != null;
      allow write: if false; // Cloud Functions use admin SDK
    }

    // =====================================================================
    // COLLECTION GROUPS — needed for cross-user queries
    // =====================================================================

    // balanceScoreHistory collection group (for percentile rankings)
    match /{path=**}/balanceScoreHistory/{dateID} {
      allow read: if request.auth != null;
    }

    // comments collection group (for deleteAccount cleanup)
    // Only Cloud Functions use this (admin SDK), but the rule is here for safety
    match /{path=**}/comments/{commentID} {
      allow read: if request.auth != null;
    }
  }
}
